# Text files are stored with LF in the repository; Git converts them on checkout.
* text=auto

# Windows tooling: keep CRLF in the working copy everywhere.
*.ahk  text eol=crlf
*.ps1  text eol=crlf
*.iss  text eol=crlf

# Shell / YAML for Linux runners: always LF.
*.yml  text eol=lf
*.yaml text eol=lf

# Binary
*.png  binary
*.ico  binary
*.exe  binary
*.zip  binary
